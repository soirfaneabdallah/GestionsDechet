# ---------- Données générées par l'application ----------
# (au cas où on lance l'app depuis le repo en dev)

# Bibliothèques utilisateur (normalement dans %APPDATA%, mais au cas où)
configs/
data/
user_data/

# Cache : images importées, coefficients Fourier, vignettes
cache/
*.cache

# Imports utilisateur
imports/

# Rapports générés
reports/
rapport_*/
!docs/exemples/rapport_demo.pdf
!docs/exemples/rapport_demo/

# État de session
state.json
*.state.json

# ---------- Audio ----------
# WAV générés ou importés (les WAV de ressources sont versionnés)
*.wav
*.mp3
*.flac
*.ogg
*.m4a
!resources/sounds/*.wav

# Fichiers temporaires audio
*.tmp.wav

# ---------- Images générées / cache ----------
# Les visuels générés à la volée ne sont pas versionnés
*.png
*.jpg
*.jpeg
*.gif
*.webp

# MAIS : on garde les assets de ressources et docs
!resources/icons/*.png
!resources/icons/*.svg
!docs/screenshots/*.png
!docs/screenshots/*.gif
!docs/exemples/*.png
!docs/exemples/*.gif

# ---------- Modèles de deep learning ----------
# Les modèles YOLO / DINOv2 sont téléchargés par scripts/download_models.py
models/
*.pt
*.pth
*.onnx
*.bin
*.safetensors
*.h5
*.pkl
*.joblib

# ---------- Données de rapport ----------
# Fichiers JSON générés par les rapports
rapport_*/data/
*.rapport.json

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- Logs ----------
*.log
logs/

# ---------- Secrets et configuration locale ----------
.env
.env.*
!.env.example
secrets.json
*.secret
*.key
*.pem

# ---------- Fichiers système Windows ----------
$RECYCLE.BIN/
*.lnk
*.stackdump

# ---------- Divers ----------
*.bak
*.orig
*.rej
